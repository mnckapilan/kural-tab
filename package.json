{
  "name": "kural-tab",
  "version": "1.1.0",
  "description": "Replace your new tab with daily Thirukkural couplets, offering timeless wisdom and reflection.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "start": "wxt",
    "build": "wxt build",
    "local": "KURAL_LOCAL=1 wxt build && mkdir -p ~/.kural-tab/local && rsync -a --delete .output/chrome-mv3/ ~/.kural-tab/local/",
    "zip": "wxt zip",
    "submit": "wxt submit",
    "pretest": "npm run build",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnckapilan/kural-tab.git"
  },
  "author": "mnckapilan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mnckapilan/kural-tab/issues"
  },
  "homepage": "https://github.com/mnckapilan/kural-tab#readme",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
